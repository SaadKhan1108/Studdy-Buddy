# Optional. Copy to secrets.toml (git-ignored) or paste into Streamlit Cloud > Settings > Secrets.
# If you set this, EVERY visitor uses your key and your free-tier quota. For a public demo it is
# safer to leave it out and let judges paste their own free key in the sidebar.
GEMINI_API_KEY = "your-key-here"
GROQ_API_KEY = "your-groq-key-here"
